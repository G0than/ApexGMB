{
  "manifest_version": 3,
  "name": "ApexGMB - Local SEO & Audit Engine",
  "version": "3.0.2",
  "description": "ApexGMB - Autonomous Google Business Profile & Local Rank Engine with Gemini 3.8 and 6-in-1 Ahrefs SEO Suite.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.google.com/maps/*",
    "https://*.google.com/search*",
    "https://openrouter.ai/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ApexGMB - Local SEO & Audits"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.google.com/maps/*",
        "https://*.google.com/search*"
      ],
      "js": [
        "injected.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.google.com/maps/*",
        "https://*.google.com/search*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_end"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
